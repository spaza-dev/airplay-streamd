# Admin API bearer token. Leave empty to disable admin authentication
# (recommended only when bound to localhost or behind an authenticating proxy).
INDEXER_ADMIN_TOKEN=

# Shared token required by POST /api/events/recording-complete.
INDEXER_EVENT_TOKEN=

# S3-compatible storage. These values are applied on every startup.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_PATH_STYLE=false

# Optional destination overrides. When empty, the source values above are used.
S3_DEST_ENDPOINT=
S3_DEST_REGION=
S3_DEST_BUCKET=
S3_DEST_ACCESS_KEY_ID=
S3_DEST_SECRET_ACCESS_KEY=
S3_DEST_PREFIX=
S3_DEST_PATH_STYLE=
