{
  "openapi": "3.0.3",
  "info": {
    "title": "Olaf Daily Indexer API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "summary": "Readiness check",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "List jobs",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stream_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "stream_id",
                  "date"
                ],
                "properties": {
                  "stream_id": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "force": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "200": {
            "description": "Existing active job"
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "summary": "Job detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/jobs/{id}/retry": {
      "post": {
        "summary": "Retry failed job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requeued"
          }
        }
      }
    },
    "/api/jobs/{id}/cancel": {
      "post": {
        "summary": "Cancel job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled or cancellation requested"
          }
        }
      }
    },
    "/api/jobs/{id}/timeline": {
      "get": {
        "summary": "Timeline detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/jobs/{id}/timeline/summary": {
      "get": {
        "summary": "Timeline summary",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/discovery/config": {
      "get": {
        "summary": "Get discovery configuration",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Update discovery configuration",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/discovery/run": {
      "post": {
        "summary": "Run discovery scan now",
        "responses": {
          "200": {
            "description": "Scan result"
          }
        }
      }
    },
    "/api/discovery/runs": {
      "get": {
        "summary": "Discovery run history",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/discovery/runs/{id}": {
      "get": {
        "summary": "Discovery run detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/events/recording-complete": {
      "post": {
        "summary": "Recorder completion event",
        "description": "Uses X-Event-Token when configured.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "stream_id",
                  "date"
                ],
                "properties": {
                  "event_id": {
                    "type": "string"
                  },
                  "stream_id": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "409": {
            "description": "Scan busy or no recordings"
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Service statistics",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/logs": {
      "get": {
        "summary": "Logs",
        "parameters": [
          {
            "name": "job_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stage",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/storage": {
      "get": {
        "summary": "List storage configs",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create storage config",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/storage/{id}": {
      "put": {
        "summary": "Update storage config",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "summary": "Delete storage config",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/storage/{id}/test": {
      "post": {
        "summary": "Test storage connection",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "502": {
            "description": "Connection failed"
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Get runtime worker settings",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Update runtime worker settings",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid settings"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
