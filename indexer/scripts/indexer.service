[Unit]
Description=Olaf Daily Indexer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
EnvironmentFile=-@CONFIGDIR@/.env
Environment=HOME=@STATE@
WorkingDirectory=@STATE@
ExecStart=@PREFIX@/indexer serve --config @CONFIGDIR@/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@STATE@ @LOGDIR@

[Install]
WantedBy=multi-user.target
