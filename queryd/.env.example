# Admin API bearer token. Leave empty only when bound to localhost or behind
# an authenticating proxy.
QUERYD_ADMIN_TOKEN=

# Optional HMAC secret used to sign callback requests.
QUERYD_CALLBACK_SECRET=

# S3-compatible archive storage. These values are read on every startup.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
S3_PATH_STYLE=true
