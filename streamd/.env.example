# S3 / Cloudflare R2 credentials for the streamd uploader.
# Copy to streamd/.env or the repo root .env (mode 0640) and fill in. Never commit real credentials.

S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=spaza-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
