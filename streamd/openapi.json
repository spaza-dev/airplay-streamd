{
  "openapi": "3.0.3",
  "info": {
    "title": "streamd Public API",
    "description": "Read-only stream overview endpoints. The API is unauthenticated when server.admin_token is empty.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/streams": {
      "get": {
        "summary": "List enabled streams",
        "description": "Returns overview data for all streams with enabled: true. Authentication is optional and controlled by server.admin_token.",
        "security": [
          {},
          {
            "bearerAuth": []
          },
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Enabled streams",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown API path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/control/discovery/radio": {
      "get": {
        "summary": "Search Radio Browser stations",
        "description": "Searches the configured Radio Browser endpoint. Results are cached in memory. Returns 404 when discovery is disabled and 502 for upstream errors.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "countrycode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "codec",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "hidebroken",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "clickcount"
            }
          },
          {
            "name": "reverse",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching stations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stations"
                  ],
                  "properties": {
                    "stations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DiscoveryStation"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Discovery disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Radio Browser request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/control/discovery/radio/{uuid}": {
      "get": {
        "summary": "Get a Radio Browser station",
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Station",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscoveryStation"
                }
              }
            }
          },
          "404": {
            "description": "Station not found or discovery disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Radio Browser request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "adminToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Token"
      }
    },
    "schemas": {
      "StreamsResponse": {
        "type": "object",
        "required": [
          "streams"
        ],
        "properties": {
          "streams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stream"
            }
          }
        }
      },
      "Stream": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "type",
          "url",
          "enabled",
          "last_activity",
          "audio",
          "video"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "stopped",
              "error",
              "idle"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "radio",
              "tv",
              "hls",
              "direct",
              "youtube",
              "twitch",
              "web"
            ]
          },
          "url": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "last_activity": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "audio": {
            "$ref": "#/components/schemas/AudioConfig"
          },
          "video": {
            "$ref": "#/components/schemas/VideoConfig"
          },
          "error": {
            "type": "string",
            "description": "Present when the stream has an active recording error."
          }
        }
      },
      "AudioConfig": {
        "type": "object",
        "required": [
          "codec",
          "container",
          "bitrate",
          "sample_rate",
          "channels"
        ],
        "properties": {
          "codec": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "bitrate": {
            "type": "string"
          },
          "sample_rate": {
            "type": "integer"
          },
          "channels": {
            "type": "integer"
          },
          "vbr": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "VideoConfig": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "nullable": true
          },
          "codec": {
            "type": "string"
          },
          "bitrate": {
            "type": "string"
          },
          "container": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "RadioStation": {
        "type": "object",
        "properties": {
          "stationuuid": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "url_resolved": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "favicon": {
            "type": "string"
          },
          "tags": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "countrycode": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "codec": {
            "type": "string"
          },
          "bitrate": {
            "type": "integer"
          },
          "hls": {
            "type": "integer"
          },
          "lastcheckok": {
            "type": "integer"
          },
          "votes": {
            "type": "integer"
          }
        }
      },
      "DiscoveryStation": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RadioStation"
          },
          {
            "type": "object",
            "required": [
              "already_added"
            ],
            "properties": {
              "already_added": {
                "type": "boolean"
              },
              "existing_stream_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      }
    }
  }
}
